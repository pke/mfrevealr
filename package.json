{
  "name": "mfrevealr",
  "version": "10.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "postversion": "react-native-version",
    "android": "react-native run-android",
    "release:android": "npx react-native build-android --mode=release",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "catalog:release": "node scripts/catalog-release.mjs",
    "screenshots": "node scripts/store-screenshots.mjs",
    "e2e:build:ios": "cd ios && E2E_BUILD=1 EXTRA_PACKAGER_ARGS=--reset-cache xcodebuild -workspace mfrevealr.xcworkspace -scheme mfrevealr -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ../build/e2e-ios build",
    "e2e:build:iphone": "cd ios && E2E_BUILD=1 EXTRA_PACKAGER_ARGS=--reset-cache xcodebuild -workspace mfrevealr.xcworkspace -scheme mfrevealr -configuration Release -sdk iphoneos -destination 'generic/platform=iOS' -derivedDataPath ../build/e2e-iphone -allowProvisioningUpdates DEVELOPMENT_TEAM=K9VADMGRA7 build",
    "e2e:build:android": "cd android && ./gradlew --stop && E2E_BUILD=1 ./gradlew app:createBundleE2eJsAndAssets --rerun app:assembleE2e",
    "e2e": "e2e run"
  },
  "resolutions": {
    "styled-components": "^5",
    "@types/react": "^19.2.0"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "2.41.0",
    "i18next": "26.7.1",
    "react": "19.3.0",
    "react-i18next": "17.1.11",
    "react-native": "0.88.1",
    "react-native-haptic-feedback": "3.0.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "5.11.0",
    "react-native-vision-camera": "4.7.3"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.94",
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@e2e-dev/mobile": "0.12.5",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "ai": "7.0.159",
    "e2e": "0.22.0",
    "eslint": "^8.19.0",
    "eslint-plugin-ft-flow": "2.0.3",
    "jest": "^29.6.3",
    "patch-package": "^8.0.0",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "2.8.8",
    "react-native-version": "4.0.0",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "codegenConfig": {
    "name": "MfrevealrSpecs",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "dev.dudesoft.mfrevealr.specs"
    },
    "ios": {
      "modulesProvider": {
        "CloudKeyValues": "RCTCloudKeyValues"
      }
    }
  }
}
