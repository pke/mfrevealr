# Signing secrets and device backups
android/keystore.properties
*.jks
*.ab
backup.tar

# fastlane credentials (App Store Connect API key) and signing downloads
**/fastlane/.env
# e2e secrets (ANTHROPIC_API_KEY), see e2e/.env.example
e2e/.env.local
*.cer
*.certSigningRequest
*.mobileprovision

# Generated catalog release (scripts/catalog-release.mjs)
dist/

# Generated by scripts/store-screenshots.mjs
screenshots/generated/

# e2e output (reports, traces, logs); the replay cache may be committed so CI
# replays recorded agent steps without model calls
.e2e/*
!.e2e/cache/
